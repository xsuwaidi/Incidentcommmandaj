rules_version = '2';
// Photos and video from the field: signed-in devices only, up to 21 MB per file.
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 21 * 1024 * 1024;
    }
  }
}
